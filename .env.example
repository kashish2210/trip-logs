# ──────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env for local development (never commit .env)
# On Render, set these as Environment Variables in the dashboard or
# they are auto-read from render.yaml.
# ──────────────────────────────────────────────────────────────────────────

# Django core
DJANGO_SECRET_KEY=dev-insecure-change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF (only needed when DEBUG=0)
# DJANGO_CSRF_ORIGINS=https://trip-logs.onrender.com

# Geo / routing upstreams (defaults work fine; override if self-hosting)
# OSRM_BASE_URL=https://router.project-osrm.org
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# GEO_USER_AGENT=eld-trip-planner/1.0 (hos-compliance-demo)
# GEO_HTTP_TIMEOUT=25
# GEO_ALLOW_FALLBACK=1
